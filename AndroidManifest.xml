<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.rojama.pianoshelf"
    android:versionCode="4"
    android:versionName="2.2.0-android16">

    <!-- Scoped Storage: Android 13+ (API 33) these are null-granted; we declare maxSdkVersion=32 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      MANAGE_EXTERNAL_STORAGE: 允许 App 访问 /storage/emulated/0 下所有文件（类 ES File Explorer）。
      用户必须手动在系统设置里授权一次（Settings → Apps → 所有文件访问权限）。
      小米 HyperOS / 原生 Android 11+ 都是这个流程。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 声明可以查询 Settings 里的文件权限页面（华为/小米/OPPO 有自己的路径） -->
    <queries>
        <intent>
            <action android:name="android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APP_FILE_PERMISSIONS" />
        </intent>
    </queries>

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.PianoShelf"
        android:hardwareAccelerated="true">

        <activity
            android:name=".PianoShelfActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GraphicsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PianoShelf.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.recordare.musicxml" />
                <data android:mimeType="application/vnd.recordare.musicxml+xml" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:pathPattern=".*\\.xml" />
                <data android:pathPattern=".*\\.mxl" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppPreferenceActivity"
            android:exported="false"
            android:label="@string/per_display"
            android:theme="@style/Theme.PianoShelf.Settings" />

        <activity
            android:name=".OnlineScoreActivity"
            android:exported="false"
            android:label="@string/tab_online"
            android:theme="@style/Theme.PianoShelf.Settings"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout" />

        <activity
            android:name=".InAppBrowseActivity"
            android:exported="false"
            android:label="@string/browse_title"
            android:theme="@style/Theme.PianoShelf.Settings"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout" />

        <activity
            android:name=".PlatformWebViewActivity"
            android:exported="false"
            android:label="@string/webview_default_title"
            android:theme="@style/Theme.PianoShelf.Settings"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.rojama.pianoshelf.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
