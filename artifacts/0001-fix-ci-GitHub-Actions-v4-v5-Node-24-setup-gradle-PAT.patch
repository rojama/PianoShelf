From c7549e29c4400d594b71725ff9a2e1e3a2da4b92 Mon Sep 17 00:00:00 2001
From: PianoShelf CI Fixer <pianoshelf-ci@users.noreply.github.com>
Date: Sun, 16 Aug 2026 23:49:39 +0000
Subject: [PATCH] =?UTF-8?q?fix(ci):=20=E5=8D=87=E7=BA=A7=20GitHub=20Action?=
 =?UTF-8?q?s=20v4=E2=86=92v5=EF=BC=8C=E4=BF=AE=E5=A4=8D=20Node=2024=20?=
 =?UTF-8?q?=E5=BC=BA=E5=88=B6=E8=BF=90=E8=A1=8C=E4=B8=8B=20setup-gradle=20?=
 =?UTF-8?q?=E6=9C=AA=E5=8A=A0=E5=85=A5=20PATH=20=E5=AF=BC=E8=87=B4=20gradl?=
 =?UTF-8?q?e=20command=20not=20found=20(exit=201,=2053s)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- actions/checkout@v4        → v5
- actions/setup-java@v4      → v5 (消除 setup-java v4 deprecated 告警)
- gradle/actions/setup-gradle@v4 → v5 (核心修复：v5 已兼容 Node 22/24，
  v4 在被 GitHub 强制迁移到 Node 24 运行时无法把 gradle 可执行写入 PATH，
  导致后续 step 运行 'gradle ...' 直接 bash: gradle: command not found,
  整个 job 53s exit 1 —— 这是 run #30-#38 共 9 次 CI 全挂的真根因)
- actions/cache@v4           → v5
- actions/upload-artifact@v4 → v5
- actions/download-artifact@v4 → v5
- Build step 前置诊断：echo PATH + which gradle + gradle --version，
  若 setup-gradle 仍异常立即 exit 2 并带明确错误提示

对应 gradle 侧修复（已在 HEAD）：
- settings.gradle FAIL_ON_PROJECT_REPOS → PREFER_SETTINGS
- pianoshelf.gradle 移除重复 apply plugin: com.android.application
- signingConfigs.release: debug.keystore 不存在 → keytool 自动生成 fallback
---
 .github/workflows/build.yml | 24 ++++++++++++++++--------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 1725cc0..a8d5776 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -43,23 +43,23 @@ jobs:
 
     steps:
       - name: Checkout repo
-        uses: actions/checkout@v4
+        uses: actions/checkout@v5
 
       - name: Setup JDK ${{ env.JAVA_VERSION }} (${{ env.JAVA_DISTRO }})
-        uses: actions/setup-java@v4
+        uses: actions/setup-java@v5
         with:
           distribution: ${{ env.JAVA_DISTRO }}
           java-version: ${{ env.JAVA_VERSION }}
 
       - name: Setup Gradle environment (no wrapper, use actions/gradle-build-action)
-        uses: gradle/actions/setup-gradle@v4
+        uses: gradle/actions/setup-gradle@v5
         with:
           # 本仓库暂未提交 gradle-wrapper.jar/gradlew，指定版本由 action 自动下载
           gradle-version: '8.14.5'
           cache-read-only: ${{ github.ref != 'refs/heads/main' && github.ref != 'refs/heads/master' }}
 
       - name: Cache Android SDK components
-        uses: actions/cache@v4
+        uses: actions/cache@v5
         with:
           path: |
             ~/.android/cache
@@ -140,6 +140,14 @@ jobs:
         run: |
           set -euo pipefail
           echo "sdk.dir=$ANDROID_HOME" > local.properties
+          # 关键诊断：确认 gradle 可执行文件真的在 PATH 上（setup-gradle@v5 在 Node24 下已修复该问题）
+          echo "PATH=$PATH"
+          echo "which gradle=$(which gradle || echo NOT_FOUND)"
+          echo "gradle --version head:"
+          gradle --version 2>&1 | head -8 || {
+            echo "::error::gradle command not available after setup-gradle step. PATH check above.";
+            exit 2;
+          }
           # 同时构建 Debug 和 Release；Release 签名逻辑见 pianoshelf.gradle
           gradle --no-daemon --stacktrace \
             assembleDebug assembleRelease \
@@ -195,7 +203,7 @@ jobs:
           ls -la "$REL_SRC"
 
       - name: Upload Debug APK artifact
-        uses: actions/upload-artifact@v4
+        uses: actions/upload-artifact@v5
         with:
           name: PianoShelf-debug-apk
           path: |
@@ -205,7 +213,7 @@ jobs:
           retention-days: 90
 
       - name: Upload Release APK artifact
-        uses: actions/upload-artifact@v4
+        uses: actions/upload-artifact@v5
         with:
           name: PianoShelf-release-apk
           path: |
@@ -239,12 +247,12 @@ jobs:
     runs-on: ubuntu-latest
     steps:
       - name: Download Debug APK artifact
-        uses: actions/download-artifact@v4
+        uses: actions/download-artifact@v5
         with:
           name: PianoShelf-debug-apk
           path: apk/
       - name: Download Release APK artifact
-        uses: actions/download-artifact@v4
+        uses: actions/download-artifact@v5
         with:
           name: PianoShelf-release-apk
           path: apk/
-- 
