<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/relativeLayout" android:layout_height="match_parent"
	android:layout_width="match_parent" android:scrollbars="horizontal|vertical">

	<!-- 乐谱画布容器（GraphicsView 往这里塞 ViewScroll / TouchView） -->
	<LinearLayout android:orientation="vertical"
		android:id="@+id/linearLayout_image" android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_above="@+id/player_control_bar">
	</LinearLayout>

	<!-- 顶部横向加载进度条 + 文字（加载完后变成播放/状态文字） -->
	<ProgressBar android:layout_width="260dp"
		android:layout_height="wrap_content" style="?android:attr/progressBarStyleHorizontal"
		android:id="@+id/progressBar" android:layout_centerHorizontal="true"
		android:max="100"
		android:progress="0"
		android:indeterminate="false"
		android:layout_marginTop="16dp"
		android:layout_alignParentTop="true">
	</ProgressBar>

	<TextView
		android:id="@+id/progressText"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_below="@id/progressBar"
		android:layout_centerHorizontal="true"
		android:textSize="12sp"
		android:textColor="#37474F"
		android:padding="4dp"
		android:text="准备中… 0%"/>

	<!-- 底部播放控制条（始终显示） -->
	<LinearLayout
		android:id="@+id/player_control_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:background="#F5F5F5"
		android:elevation="6dp"
		android:padding="4dp"
		android:layout_alignParentBottom="true">

		<TextView
			android:id="@+id/btn_prev_page"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="⏮"
			android:textSize="20sp"
			android:textColor="#37474F"
			android:paddingStart="8dp"
			android:paddingEnd="8dp"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="上一页"/>

		<TextView
			android:id="@+id/btn_play_pause"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="⏵"
			android:textSize="24sp"
			android:textColor="#2E7D32"
			android:paddingStart="10dp"
			android:paddingEnd="10dp"
			android:paddingTop="6dp"
			android:paddingBottom="6dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="播放/暂停"/>

		<TextView
			android:id="@+id/btn_next_page"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="⏭"
			android:textSize="20sp"
			android:textColor="#37474F"
			android:paddingStart="8dp"
			android:paddingEnd="8dp"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="下一页"/>

		<SeekBar
			android:id="@+id/seek_playback"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:max="10000"
			android:progress="0"
			android:enabled="false"
			android:paddingStart="8dp"
			android:paddingEnd="8dp"/>

		<TextView
			android:id="@+id/tv_page_info"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="第 1 / 1 页"
			android:textSize="12sp"
			android:textColor="#455A64"
			android:paddingStart="6dp"
			android:paddingEnd="8dp"
			android:paddingTop="4dp"
			android:paddingBottom="4dp"/>
	</LinearLayout>

	<!-- 调试日志面板：默认 GONE，仅在 加载/渲染/解析失败 时自动弹出作为浮层覆盖控制条+乐谱底部
	     交互：
	       - 点击 × ：隐藏面板
	       - 点击 ⤢ ：在 半高(≈35%屏) / 全屏 之间切换
	       - 点击标题栏空白：折叠为仅标题（1行，再点一次恢复）
	       - 物理返回键（Back）：若展开中 → 先隐藏面板；面板隐藏时 → 正常退出 Activity
	-->
	<LinearLayout
		android:id="@+id/debug_log_panel"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:maxHeight="10000dp"
		android:orientation="vertical"
		android:background="#263238"
		android:layout_alignParentBottom="true"
		android:elevation="12dp"
		android:visibility="gone">

		<LinearLayout
			android:id="@+id/log_title_bar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:background="#1A2327"
			android:paddingStart="8dp"
			android:paddingEnd="4dp"
			android:paddingTop="2dp"
			android:paddingBottom="2dp">

			<TextView
				android:id="@+id/log_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:padding="4dp"
				android:text="调试日志（加载失败时自动弹出；可上下滚动；点击进度文字/按返回键/点×可关闭）"
				android:textColor="#FFFFFF"
				android:textSize="11sp"/>

			<TextView
				android:id="@+id/btn_log_toggle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="⤢"
				android:textColor="#80DEEA"
				android:textSize="18sp"
				android:paddingStart="8dp"
				android:paddingEnd="8dp"
				android:paddingTop="4dp"
				android:paddingBottom="4dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="切换面板大小"/>

			<TextView
				android:id="@+id/btn_log_close"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="×"
				android:textColor="#EF9A9A"
				android:textSize="26sp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:paddingTop="0dp"
				android:paddingBottom="4dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="关闭日志面板"/>
		</LinearLayout>

		<ScrollView
			android:id="@+id/logScroll"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="160dp"
			android:maxHeight="280dp"
			android:background="#263238"
			android:scrollbars="vertical"
			android:fillViewport="true">

			<TextView
				android:id="@+id/logText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="6dp"
				android:textSize="10sp"
				android:lineSpacingExtra="-1dp"
				android:fontFamily="monospace"
				android:textColor="#AEEA00"
				android:text=""/>
		</ScrollView>
	</LinearLayout>
</RelativeLayout>
