<?xml version="1.0" encoding="utf-8"?>
<!-- HyperOS 3 设计系统颜色 -->
<resources>
    <!-- 主色：浅靛蓝 (HyperOS signature) -->
    <color name="hyperos_primary">#5C6BC0</color>
    <color name="hyperos_primary_dark">#3F51B5</color>
    <!-- 次色：柔和青色 -->
    <color name="hyperos_secondary">#26A69A</color>
    <!-- 背景：极浅灰白 (HyperOS 轻盈感) -->
    <color name="hyperos_background">#FAFAFA</color>
    <color name="hyperos_surface">#FFFFFF</color>
    <!-- 底部导航背景：半透明白 (毛玻璃感) -->
    <color name="hyperos_bottom_nav_bg">#F2F2F2</color>
    <color name="hyperos_bottom_nav_divider">#1A000000</color>
    <!-- 文字颜色 -->
    <color name="hyperos_text_primary">#212121</color>
    <color name="hyperos_text_secondary">#757575</color>
    <!-- 未选中状态 -->
    <color name="hyperos_unselected">#8A8A8A</color>
    <!-- 彩色圆角图标背景 (文件列表用) -->
    <color name="hyperos_folder_bg">#FFF3E0</color>
    <color name="hyperos_music_bg">#E8F5E9</color>
    <!-- 卡片分割线 -->
    <color name="hyperos_divider">#EEEEEE</color>
</resources>
