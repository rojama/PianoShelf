	<!-- ================= 在线乐谱模块 ================= -->
	<!-- Tab 欢迎卡片 -->
	<string name="tab_online_guide_title">在线下载 MusicXML 乐谱</string>
	<string name="tab_online_guide_desc">支持从 MuseScore、IMSLP、Mutopia 等免费平台下载乐谱，粘贴文件直链即可一键下载打开。</string>

